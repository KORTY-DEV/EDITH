{
  // Сколько ждать начала фразы после «Эдит».
  "speechStartTimeoutSeconds": 6,

  // Без Smart Turn: пауза, после которой фраза считается законченной.
  "speechEndSilenceMilliseconds": 850,

  // Smart Turn (models/smart-turn): после короткой паузы модель по звуку решает, договорил ли ты.
  // «Не договорил» — ждёт ещё до turnMaxHoldMilliseconds. Нет файла модели — работает по паузе выше.
  "smartTurn": true,
  "turnEndSilenceMilliseconds": 550,
  "turnMaxHoldMilliseconds": 1500,

  // Программное эхоподавление для стоп-слова. По умолчанию выключено: MCHOSE S9 PRO подавляет
  // свои колонки сам (замер 02.10), фильтр там только добавлял шум. Включите для других колонок.
  "echoCancel": false,

  // Ответ в разговоре начинает звучать с первого предложения, пока модель дописывает остальное.
  "streamSpeech": true,

  // Фраза оборвалась на «и», «в», «что»… — подождать продолжение.
  "continueAfterDanglingWord": true
}
