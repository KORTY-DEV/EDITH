{
  // Заметки Obsidian как знания EDITH: она ищет и читает их, когда вы спрашиваете про проекты,
  // задачи, идеи и учёбу. Скопируйте в vault.json и укажите своё хранилище.
  // Содержимое найденных заметок уходит в облачный мозг (GigaChat) только в ответ на вопрос.
  "enabled": true,
  "path": "C:/Obsidian/MyVault",
  // Папки хранилища для чтения.
  "folders": ["00_INBOX", "10_MyProject"],
  // Файлы вне хранилища.
  "extraFiles": []
}
